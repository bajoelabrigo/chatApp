# ── Núcleo ───────────────────────────────────────────────────
PORT=3000
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/chatapp
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=otro_secreto_diferente_largo_y_aleatorio

# Base compartida con la web (holy_app): valida los tokens que emite su backend.
WEB_JWT_SECRET=el_mismo_secreto_que_usa_holy_app

# ── URLs ─────────────────────────────────────────────────────
BACKEND_URL=https://api.holyholyholy.es
FRONTEND_URL=https://holyholyholy.es

# ── Google Sign-In ───────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=tu-web-client-id.apps.googleusercontent.com

# ── Cloudinary (media del chat) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Correo (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@holyholyholy.es
SMTP_PASS=
SMTP_FROM=HolyChat <info@holyholyholy.es>

# ── LiveKit (llamadas grupales) ──────────────────────────────
LIVEKIT_API_KEY=tu_livekit_api_key
LIVEKIT_API_SECRET=tu_livekit_api_secret
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud

# ── PayPal (ofrendas y suscripciones) ────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Seis niveles, no tres. Se resuelven por nombre (`PAYPAL_PLAN_${tier}_ID`)
# desde offeringController.ts, así que un nivel sin su plan queda inservible.
PAYPAL_PLAN_SUB_5_ID=
PAYPAL_PLAN_SUB_10_ID=
PAYPAL_PLAN_SUB_20_ID=
PAYPAL_PLAN_SUB_50_ID=
PAYPAL_PLAN_SUB_100_ID=
PAYPAL_PLAN_SUB_200_ID=

# ── Web Push (avisos del navegador) ──────────────────────────
# Generar con: npx web-push generate-vapid-keys
# NUNCA generar claves nuevas para "arreglar" el push: invalida todas las
# suscripciones existentes y esos usuarios dejan de recibir avisos sin enterarse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@holyholyholy.es

# ── Opcional ─────────────────────────────────────────────────
# Verbosidad del log: debug | info | warn | error. Por defecto "info".
# Con "debug" se encienden las trazas de alta frecuencia (una por reacción de
# mensaje, p. ej.), que en producción ahogarían el log de PM2.
LOG_LEVEL=info

# Fondos de foto para "compartir versículo como imagen". Sin ella,
# /public/photos responde 503 y los temas de color siguen funcionando.
PEXELS_API_KEY=
BIBLIA_API_KEY=tu-key-de-api.biblia.com
